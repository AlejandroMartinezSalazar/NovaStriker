# Finales de línea normalizados en el repositorio (Windows los convierte al sacar los archivos).
* text=auto

# Scripts de Windows siempre con CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos de Unity en YAML: texto.
*.unity text
*.prefab text
*.asset text
*.mat text
*.meta text
*.anim text
*.controller text
*.physicMaterial text
*.asmdef text

# Binarios: nunca tocar sus bytes.
*.png binary
*.jpg binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.bundle binary
*.aar binary
*.jar binary
*.exe binary
